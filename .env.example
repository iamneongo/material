# Neon Postgres (serverless) — connection string
# Lấy từ Neon dashboard: https://console.neon.tech (dùng chuỗi "Pooled connection")
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# Better Auth — sinh secret ngẫu nhiên: `openssl rand -hex 32`
BETTER_AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
