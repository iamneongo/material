{
  "name": "material",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:native": "expo export --platform android && expo export --platform ios",
    "server": "pnpm --dir server dev",
    "web:legacy": "next dev",
    "build:legacy": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/expo": "1.7.5",
    "@expo-google-fonts/google-sans-flex": "^0.4.5",
    "@expo/metro-runtime": "^57.0.15",
    "@neondatabase/serverless": "^0.10.4",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tamagui/config": "^2.7.7",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.38.4",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-file-system": "^57.0.7",
    "expo-font": "^57.0.4",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "^57.0.4",
    "expo-sharing": "^57.0.20",
    "lucide-react": "^0.469.0",
    "lucide-react-native": "^1.46.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-paper": "5.15.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tamagui": "^2.7.7",
    "tw-animate-css": "^1.4.0"
